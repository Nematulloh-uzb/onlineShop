# Copy to .env, generate unique secrets, and keep .env out of version control.
MONGO_ROOT_USERNAME=aura_admin
# Use a URL-safe password (for example, 64 hexadecimal characters).
MONGO_ROOT_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Public HTTPS origin served by the TLS-terminating reverse proxy.
CLIENT_URL=https://shop.example.com
# Bind the application privately for a local TLS reverse proxy.
CLIENT_PORT=3000
